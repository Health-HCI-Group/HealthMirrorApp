<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="健康镜蓝牙通信"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:gravity="center" />

            <Button
                android:id="@+id/toggleTtsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="🔊"
                android:textSize="16sp"
                android:backgroundTint="#4CAF50"
                android:textColor="#fff"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="⚙"
                android:textSize="18sp"
                android:backgroundTint="#607D8B"
                android:textColor="#fff" />
        </LinearLayout>

        <!-- 状态栏 -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Ready"
            android:textSize="16sp"
            android:padding="12dp"
            android:textColor="#222"
            android:background="#E0F7FA"
            android:layout_marginBottom="12dp"
            android:elevation="2dp" />

        <!-- 蓝牙控制按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/scanButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="扫描设备"
                android:backgroundTint="#2196F3"
                android:textColor="#fff"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/connectButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="连接设备"
                android:backgroundTint="#03A9F4"
                android:textColor="#fff"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- 设备列表 -->
        <ListView
            android:id="@+id/deviceListView"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#FFFFFF"
            android:divider="#ddd"
            android:dividerHeight="1dp"
            android:elevation="1dp"
            android:layout_marginBottom="16dp" />

        <!-- 患者信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="患者信息"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/patientIdEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="患者ID"
                android:inputType="number"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:background="@android:drawable/editbox_background"/>

            <!-- 动态健康指标容器 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="健康指标"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <!-- 动态生成的健康指标输入框将在这里添加 -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="300dp">

                    <LinearLayout
                        android:id="@+id/healthIndicatorsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <!-- 健康指标输入框将动态添加到这里 -->
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <EditText
                android:id="@+id/patientCustomInfoEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="自定义信息"
                android:padding="12dp"
                android:background="@android:drawable/editbox_background"/>
        </LinearLayout>

        <!-- 采集控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/startCaptureButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="开始采集"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#4CAF50"
                android:textColor="#fff" />

            <Button
                android:id="@+id/stopCaptureButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="停止采集"
                android:layout_marginStart="6dp"
                android:backgroundTint="#F44336"
                android:textColor="#fff"
                android:enabled="false"/>
        </LinearLayout>

        <!-- 采集进度 -->
        <LinearLayout
            android:id="@+id/TimeBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/captureProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/captureTimeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="14sp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- 功能按钮组 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/syncTimeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="时间同步"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#FF9800"
                android:textColor="#fff" />

            <Button
                android:id="@+id/refreshInfoButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="刷新信息"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#607D8B"
                android:textColor="#fff" />

            <Button
                android:id="@+id/configWifiButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="配置网络"
                android:layout_marginStart="4dp"
                android:backgroundTint="#673AB7"
                android:textColor="#fff" />
        </LinearLayout>

        <!-- 拍照按钮 -->
        <Button
            android:id="@+id/capturePhotoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="拍照上传"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#9C27B0"
            android:textColor="#fff"/>

        <!-- 设备信息标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设备信息:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333"
            android:layout_marginBottom="8dp" />

        <!-- 设备信息内容 -->
        <TextView
            android:id="@+id/deviceInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:background="#F1F8E9"
            android:padding="12dp"
            android:text="暂无设备信息"
            android:textSize="14sp"
            android:textColor="#444" />
    </LinearLayout>
</ScrollView>