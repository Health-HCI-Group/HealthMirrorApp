<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="←"
                android:textSize="18sp"
                android:backgroundTint="#607D8B"
                android:textColor="#fff" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="健康镜设置"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:gravity="center"
                android:layout_gravity="center_vertical" />

            <View
                android:layout_width="48dp"
                android:layout_height="48dp" />
        </LinearLayout>

        <!-- 采集时长设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="默认采集时长"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/defaultDurationEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="60"
                    android:inputType="number"
                    android:padding="12dp"
                    android:background="@android:drawable/editbox_background" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="秒"
                    android:textSize="16sp"
                    android:layout_marginStart="8dp" />

                <Button
                    android:id="@+id/saveDurationButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="保存"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#fff"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="设置默认的数据采集时长，避免每次手动输入"
                android:textSize="12sp"
                android:textColor="#666"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 健康指标标签管理 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="健康指标管理"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="12dp" />

            <!-- 添加新标签 - 改为垂直布局 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- 第一行：标签名称 -->
                <EditText
                    android:id="@+id/newTagNameEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="标签名称 (如: 血糖)"
                    android:padding="12dp"
                    android:background="@android:drawable/editbox_background"
                    android:layout_marginBottom="8dp" />

                <!-- 第二行：单位和添加按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/newTagUnitEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="单位 (如: mg/dL)"
                        android:padding="12dp"
                        android:background="@android:drawable/editbox_background"
                        android:layout_marginEnd="12dp" />

                    <Button
                        android:id="@+id/addTagButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="添加"
                        android:backgroundTint="#2196F3"
                        android:textColor="#fff"
                        android:minWidth="80dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 系统默认标签说明 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="系统默认指标 (不可删除)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#666"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/defaultTagsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">
                <!-- 系统默认标签将在这里动态添加 -->
            </LinearLayout>

            <!-- 自定义标签说明 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="自定义指标"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#666"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/customTagsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- 自定义标签将在这里动态添加 -->
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="添加的自定义指标将出现在主界面的健康指标区域"
                android:textSize="12sp"
                android:textColor="#666"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 重置按钮 -->
        <Button
            android:id="@+id/resetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="重置所有设置"
            android:layout_marginTop="20dp"
            android:backgroundTint="#F44336"
            android:textColor="#fff" />

    </LinearLayout>
</ScrollView>